*.h5
*.hdf5
*.keras
*.ckpt
*.pt
*.pth
*.onnx

# Experiment outputs, run logs, and temporary caches
experiments/*
!experiments/.gitkeep
reports/*
!reports/.gitkeep
logs/
*.log

# Secrets, credentials, and environment overrides
.env*
secrets.json
credentials.json
token.json
