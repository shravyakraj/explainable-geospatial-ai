# Datasets and Large Geospatial Files
data/raw/*
!data/raw/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.tif
*.tiff
*.jp2
*.tar.gz
*.zip
*.geojson
*.gpkg
*.parquet

# Model weights, checkpoints, and serialized graphs
models/*
