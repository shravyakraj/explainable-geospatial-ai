{
  "task": "bi-temporal_deforestation_detection",
  "dataset_manifest": "data/processed/split_manifest.json",
  "spatial_resolution_m": 10.0,
  "patch_shape": [256, 256, 4],
  "bands": ["B02", "B03", "B04", "B08"],
  "reflectance_scale": 10000.0,
  "clip_range": [0.0, 1.0],
  "random_seed": 42,
  "batch_size": 8,
  "initial_learning_rate": 0.0001,
  "optimizer": "adam",
  "loss_function": "binary_crossentropy",
  "max_epochs": 60,
  "early_stopping_patience": 16,
  "reduce_lr_patience": 8,
  "reduce_lr_factor": 0.5,
  "min_lr": 1e-06,
  "checkpoint_monitor": "val_pr_auc",
  "augmentation": {
    "random_horizontal_flip": true,
    "random_vertical_flip": true,
    "random_rot90": true,
    "synchronized_dates": true
  },
  "hardware_target": "MacBook Air M3, 8 GB unified memory, Apple Silicon Metal GPU"
}
